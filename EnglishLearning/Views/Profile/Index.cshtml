@model EnglishLearning.Models.UserProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    var paidCount = Model.PaidOrders.Count;
}

<style>
    .profile-hero {
        background: linear-gradient(135deg, #1e3a5f 0%, #2563eb 50%, #38bdf8 100%);
        color: #fff;
        padding: 36px 0 26px;
    }

    .profile-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255,255,255,0.15);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
    }

    .profile-main-card {
        border-radius: 18px;
        border: 1px solid rgba(148,163,184,0.35);
        box-shadow: 0 10px 24px rgba(15,23,42,0.16);
        background: #fff;
        overflow: hidden;
    }

    .profile-section-title {
        font-size: 0.9rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        margin-bottom: 10px;
    }
</style>

<section class="profile-hero">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="profile-avatar">
                    <i class="bi bi-person-fill"></i>
                </div>
                <div>
                    <div class="text-uppercase small mb-1" style="opacity:0.9;">Hồ sơ người dùng</div>
                    <h1 class="h3 fw-bold mb-1">@Model.User.Username</h1>
                    <div style="opacity:0.9;">
                        <i class="bi bi-envelope"></i> @Model.User.Email
                    </div>
                </div>
            </div>
            <div class="text-end">
                <div class="badge bg-primary mb-2">
                    @if (User.IsInRole("Admin"))
                    {
                        @:Quản trị viên
                    }
                    else
                    {
                        @:Người dùng
                    }
                </div>
                <div class="small" style="opacity:0.9;">
                    Tham gia từ @Model.User.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="small">
                    Trạng thái:
                    @if (Model.User.IsActive)
                    {
                        <span class="text-success fw-semibold">Đang hoạt động</span>
                    }
                    else
                    {
                        <span class="text-danger fw-semibold">Tạm khóa</span>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="mt-3"></div>
</section>

<div class="container my-4">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 g-lg-4">
        <div class="col-12 col-lg-4">
            <div class="profile-main-card p-3 h-100">
                <div class="profile-section-title">Tổng quan</div>
                <div class="mb-2">
                    <span class="text-muted small">Tên đăng nhập</span>
                    <div class="fw-semibold">@Model.User.Username</div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Email</span>
                    <div class="fw-semibold">@Model.User.Email</div>
                </div>
                <div class="mb-2">
                    <span class="text-muted small">Vai trò</span>
                    <div class="fw-semibold">
                        @if (User.IsInRole("Admin"))
                        {
                            @:Admin
                        }
                        else
                        {
                            @:User
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Khóa học đã mua</span>
                    <div class="fw-semibold">@paidCount</div>
                </div>
                <a href="/Courses/MyCourses" class="btn btn-primary w-100">
                    <i class="bi bi-collection-play"></i> Xem khóa học của tôi
                </a>
            </div>
        </div>

        <div class="col-12 col-lg-8">
            <div class="profile-main-card p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="profile-section-title mb-0">Lịch sử đơn hàng</div>
                </div>
                @if (!Model.PaidOrders.Any())
                {
                    <div class="text-muted py-3">
                        Bạn chưa có đơn hàng nào đã thanh toán.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Khóa học</th>
                                    <th>Số tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày thanh toán</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model.PaidOrders)
                                {
                                    <tr>
                                        <td>@(string.IsNullOrEmpty(o.MomoOrderId) ? ("#" + o.Id) : o.MomoOrderId)</td>
                                        <td>@o.Course?.Title</td>
                                        <td>@o.Amount.ToString("N0") đ</td>
                                        <td><span class="badge bg-success">Paid</span></td>
                                        <td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

