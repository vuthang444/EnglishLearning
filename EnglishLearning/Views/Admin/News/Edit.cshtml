@model CommonLib.Entities.News
@{
    ViewData["Title"] = "Sửa bài tin tức";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2>Sửa bài tin tức</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post" action="@Url.Action("Edit", new { id = Model.Id })" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card mb-3">
            <div class="card-header">Ảnh đại diện</div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.FeaturedImagePath))
                {
                    <div class="mb-3">
                        <label class="form-label">Ảnh hiện tại</label>
                        <div>
                            <img src="@Model.FeaturedImagePath" alt="Ảnh đại diện" class="img-fluid rounded" style="max-height: 200px;" />
                        </div>
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label">@(string.IsNullOrEmpty(Model.FeaturedImagePath) ? "Thêm ảnh đại diện" : "Thay ảnh mới")</label>
                    <input type="file" name="featuredImage" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                    <small class="form-text text-muted">Định dạng: JPG, PNG, GIF, WebP. Để trống nếu giữ ảnh hiện tại.</small>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Thông tin cơ bản</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label">Tiêu đề</label>
                    <input asp-for="Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="MetaDescription" class="form-label">Mô tả SEO</label>
                    <textarea asp-for="MetaDescription" class="form-control" rows="2"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Level" class="form-label">Trình độ</label>
                            <select asp-for="Level" class="form-select">
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            <label asp-for="Topic" class="form-label">Chủ đề</label>
                            <input asp-for="Topic" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="SourceUrl" class="form-label">Link nguồn</label>
                    <input asp-for="SourceUrl" class="form-control" type="url" />
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Nội dung</div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="Content" class="form-label">Nội dung bài tin tức</label>
                    <textarea asp-for="Content" class="form-control" rows="15" required></textarea>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Từ vựng</div>
            <div class="card-body">
                @if (Model.Vocabularies != null && Model.Vocabularies.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Từ vựng</th>
                                <th>Nghĩa tiếng Việt</th>
                                <th>Ví dụ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vocab in Model.Vocabularies.OrderBy(v => v.Order))
                            {
                                <tr>
                                    <td><strong>@vocab.Word</strong></td>
                                    <td>@vocab.VietnameseMeaning</td>
                                    <td><em>@vocab.Example</em></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">Chưa có từ vựng nào.</p>
                }
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header">Cài đặt</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsPublished" class="form-check-input" type="checkbox" />
                        <label asp-for="IsPublished" class="form-check-label">Xuất bản</label>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for="IsFreePreview" class="form-check-input" type="checkbox" />
                        <label asp-for="IsFreePreview" class="form-check-label">Cho phép Free users đọc</label>
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-save"></i> Lưu thay đổi
        </button>
        <a href="@Url.Action("Index")" class="btn btn-secondary">Hủy</a>
    </form>
</div>
