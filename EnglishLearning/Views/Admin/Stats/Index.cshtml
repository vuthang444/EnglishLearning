@model EnglishLearning.Models.AdminStatsViewModel
@{
    ViewData["Title"] = "Thống kê học tập";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var labelsJson = System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysLabels);
    var countsJson = System.Text.Json.JsonSerializer.Serialize(Model.Last7DaysCounts);
}

<div class="admin-dashboard">
    <h2 class="mb-2">Thống kê học tập</h2>
    <p class="text-muted mb-4">Tổng quan hoạt động làm bài của người dùng theo kỹ năng và theo ngày.</p>

    <div class="row g-3 mb-4">
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-bar-chart"></i> Bài làm theo kỹ năng</h5>
                    @if (!Model.SubmissionsBySkill.Any())
                    {
                        <p class="text-muted">Chưa có dữ liệu bài làm.</p>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Kỹ năng</th>
                                    <th class="text-end">Số bài làm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var kv in Model.SubmissionsBySkill.OrderByDescending(k => k.Value))
                                {
                                    <tr>
                                        <td>@kv.Key</td>
                                        <td class="text-end">@kv.Value</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-graph-up"></i> Bài làm 7 ngày gần nhất</h5>
                    <canvas id="submissionsChart" height="140"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(labelsJson);
        const data = @Html.Raw(countsJson);

        const ctx = document.getElementById('submissionsChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Số bài làm',
                    data: data,
                    borderColor: '#4A90E2',
                    backgroundColor: 'rgba(74, 144, 226, 0.15)',
                    tension: 0.3,
                    fill: true,
                    pointRadius: 4,
                    pointBackgroundColor: '#2E5C8A'
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 }
                    }
                }
            }
        });
    </script>
}

