@model EnglishLearning.Models.AdminDashboardVm
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-dashboard">
    <h2 class="mb-2">Dashboard</h2>
    <p class="text-muted mb-4">Tổng quan quản trị hệ thống EnglishLearning</p>

    <!-- Thống kê -->
    <h5 class="mb-3"><i class="bi bi-bar-chart"></i> Thống kê</h5>
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm h-100 admin-stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-stat-icon bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                        <i class="bi bi-journal-bookmark fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="text-muted small">Khóa học</div>
                        <div class="fs-4 fw-bold">@Model.CourseCount</div>
                    </div>
                    <a href="/Admin/Courses" class="btn btn-sm btn-outline-primary">Xem</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm h-100 admin-stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-stat-icon bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                        <i class="bi bi-newspaper fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="text-muted small">Tin tức</div>
                        <div class="fs-4 fw-bold">@Model.NewsCount</div>
                    </div>
                    <a href="/Admin/News" class="btn btn-sm btn-outline-info">Xem</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm h-100 admin-stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-stat-icon bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="bi bi-people fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="text-muted small">Người dùng</div>
                        <div class="fs-4 fw-bold">@Model.UserCount</div>
                    </div>
                    <a href="/Admin/Users" class="btn btn-sm btn-outline-success">Xem</a>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm h-100 admin-stat-card">
                <div class="card-body d-flex align-items-center">
                    <div class="admin-stat-icon bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                        <i class="bi bi-star-fill fs-4"></i>
                    </div>
                    <div class="flex-grow-1">
                        <div class="text-muted small">User Premium</div>
                        <div class="fs-4 fw-bold">@Model.PremiumUserCount</div>
                    </div>
                    <span class="badge bg-warning text-dark">1 năm gần đây</span>
                </div>
            </div>
        </div>
        @foreach (var skill in Model.SkillStats)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <div class="card border-0 shadow-sm h-100 admin-stat-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="admin-stat-icon bg-secondary bg-opacity-10 text-secondary rounded-3 p-3 me-3">
                            <i class="bi @skill.IconClass fs-4"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="text-muted small">@skill.Name</div>
                            <div class="fs-4 fw-bold">@skill.LessonCount <span class="fs-6 fw-normal text-muted">bài học</span></div>
                        </div>
                        <a href="@skill.AdminUrl" class="btn btn-sm btn-outline-secondary">Xem</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Shortcuts -->
    <h5 class="mb-3"><i class="bi bi-link-45deg"></i> Truy cập nhanh</h5>
    <div class="row g-3">
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/Admin/Courses" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 admin-shortcut-card text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-journal-bookmark text-primary fs-2 d-block mb-2"></i>
                        <span class="text-dark fw-medium">Quản lý khóa học</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/Admin/News" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 admin-shortcut-card text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-newspaper text-info fs-2 d-block mb-2"></i>
                        <span class="text-dark fw-medium">Tin tức</span>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6 col-md-4 col-lg-2">
            <a href="/Admin/Skills" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100 admin-shortcut-card text-center">
                    <div class="card-body py-4">
                        <i class="bi bi-gear text-secondary fs-2 d-block mb-2"></i>
                        <span class="text-dark fw-medium">Quản lý kỹ năng</span>
                    </div>
                </div>
            </a>
        </div>
        @foreach (var skill in Model.SkillStats)
        {
            <div class="col-6 col-md-4 col-lg-2">
                <a href="@skill.AdminUrl" class="text-decoration-none">
                    <div class="card border-0 shadow-sm h-100 admin-shortcut-card text-center">
                        <div class="card-body py-4">
                            <i class="bi @skill.IconClass text-secondary fs-2 d-block mb-2"></i>
                            <span class="text-dark fw-medium">@skill.Name</span>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
</div>

<style>
    .admin-stat-card:hover { transform: translateY(-2px); transition: transform 0.2s ease; }
    .admin-shortcut-card { transition: all 0.2s ease; }
    .admin-shortcut-card:hover { transform: translateY(-2px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1) !important; }
</style>