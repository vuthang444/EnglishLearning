@model EnglishLearning.Models.AdminCreateUserViewModel
@{
    ViewData["Title"] = "Tạo người dùng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var roles = ViewBag.Roles as List<CommonLib.Entities.Role> ?? new List<CommonLib.Entities.Role>();
}

<div class="admin-dashboard">
    <h2 class="mb-2">Tạo người dùng mới</h2>
    <p class="text-muted mb-4">Thêm tài khoản mới cho hệ thống</p>

    <form method="post" action="/Admin/Users/Create">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" type="password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Vai trò</label>
            <select asp-for="RoleId" class="form-select">
                @foreach (var r in roles)
                {
                    <option value="@r.Id">@r.Name</option>
                }
            </select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Tạo người dùng
        </button>
        <a href="/Admin/Users" class="btn btn-secondary ms-2">Quay lại</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

