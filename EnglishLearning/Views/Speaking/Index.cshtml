@model List<CommonLib.Entities.Lesson>
@{
    ViewData["Title"] = "Bài tập Speaking";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var submissions = ViewBag.Submissions as Dictionary<int, CommonLib.Entities.Submission> ?? new Dictionary<int, CommonLib.Entities.Submission>();
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3">
                <i class="bi bi-mic-fill text-primary"></i> Bài tập Speaking
            </h2>
            <p class="text-muted">Luyện tập kỹ năng nói tiếng Anh với AI chấm điểm tự động</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> Chưa có bài tập nào. Bạn có thể quay lại sau hoặc xem <a href="@Url.Action("Index", "Home")" class="alert-link">Trang chủ</a>.
        </div>
    }
    else
    {
        <div class="lesson-list">
            @foreach (var lesson in Model)
            {
                var submission = submissions.ContainsKey(lesson.Id) ? submissions[lesson.Id] : null;
                var hasCompleted = submission != null;
                var score = hasCompleted ? submission.Score : 0;
                var maxScore = hasCompleted ? submission.MaxScore : 100;
                var percentage = maxScore > 0 ? Math.Round(score * 100.0 / maxScore, 1) : 0;

                <div class="lesson-row-card mb-3">
                    <div class="lesson-row-main">
                        <div class="lesson-row-icon">
                            <i class="bi bi-mic-fill"></i>
                        </div>
                        <div class="lesson-row-info">
                            <div class="lesson-row-title">@lesson.Title</div>
                            @if (!string.IsNullOrEmpty(lesson.Description))
                            {
                                <div class="lesson-row-desc text-muted small">@lesson.Description</div>
                            }
                            <div class="lesson-row-meta text-muted small">
                                @if (!string.IsNullOrEmpty(lesson.Topic))
                                {
                                    <span><i class="bi bi-chat-dots"></i> Chủ đề: @lesson.Topic</span>
                                }
                                <span class="ms-3"><i class="bi bi-clock"></i> Thời gian: @lesson.TimeLimitSeconds giây</span>
                            </div>
                        </div>
                    </div>

                    <div class="lesson-row-right">
                        @if (hasCompleted)
                        {
                            <div class="lesson-row-status">
                                <span class="badge bg-success mb-1"><i class="bi bi-check-circle"></i> Đã làm</span>
                                <div class="progress lesson-row-progress" role="progressbar"
                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar @(score >= 80 ? "bg-success" : score >= 60 ? "bg-warning" : "bg-danger")"
                                         style="width:@percentage%">
                                        @score/@maxScore điểm (@percentage%)
                                    </div>
                                </div>
                            </div>
                            <div class="lesson-row-actions">
                                <a href="@Url.Action("Exercise", new { lessonId = lesson.Id })"
                                   class="btn btn-sm btn-primary">
                                    <i class="bi bi-arrow-repeat"></i> Làm lại
                                </a>
                                <a href="@Url.Action("Result", new { submissionId = submission!.Id })"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i> Xem kết quả
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="lesson-row-actions">
                                <a href="@Url.Action("Exercise", new { lessonId = lesson.Id })"
                                   class="btn btn-primary">
                                    <i class="bi bi-play-circle"></i> Bắt đầu
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .lesson-list {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .lesson-row-card {
        display: flex;
        justify-content: space-between;
        align-items: stretch;
        background: #ffffff;
        border-radius: 12px;
        padding: 16px 18px;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
        border-left: 4px solid #4A90E2;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .lesson-row-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 18px rgba(15, 23, 42, 0.12);
    }

    .lesson-row-main {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        flex: 1 1 auto;
        min-width: 0;
    }

    .lesson-row-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #e7f3ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4A90E2;
        font-size: 1.5rem;
        flex-shrink: 0;
    }

    .lesson-row-info {
        min-width: 0;
    }

    .lesson-row-title {
        font-weight: 600;
        color: #1E3A5F;
        margin-bottom: 2px;
    }

    .lesson-row-desc {
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .lesson-row-meta span {
        font-size: 0.85rem;
    }

    .lesson-row-right {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        margin-left: 20px;
        flex-shrink: 0;
    }

    .lesson-row-status {
        width: 220px;
        max-width: 100%;
    }

    .lesson-row-progress {
        height: 18px;
        font-size: 0.75rem;
    }

    .lesson-row-actions .btn {
        margin-left: 6px;
    }

    @@media (max-width: 768px) {
        .lesson-row-card {
            flex-direction: column;
        }

        .lesson-row-right {
            align-items: flex-start;
            margin-left: 0;
        }

        .lesson-row-actions .btn {
            margin-left: 0;
            margin-right: 6px;
            margin-top: 4px;
        }
    }
</style>
