<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EnglishLearning Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EnglishLearning.styles.css" asp-append-version="true" />
    <style>
        body {
            overflow-x: hidden;
        }
        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            width: 250px;
            background: linear-gradient(180deg, #1E3A5F 0%, #152a47 100%);
            padding-top: 20px;
            z-index: 1000;
            overflow-y: auto;
            box-shadow: 2px 0 12px rgba(0,0,0,0.15);
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.85);
            padding: 12px 20px;
            border-left: 3px solid transparent;
            transition: all 0.25s ease;
        }
        .sidebar .nav-link:hover {
            color: #fff;
            background-color: rgba(74, 144, 226, 0.25);
            border-left-color: #4A90E2;
        }
        .sidebar .nav-link.active {
            color: #fff;
            background-color: rgba(74, 144, 226, 0.35);
            border-left-color: #4A90E2;
        }
        .sidebar .nav-link i {
            width: 20px;
            margin-right: 10px;
        }
        .main-content {
            margin-left: 250px;
            padding: 20px;
            min-height: 100vh;
        }
        .admin-content-wrap {
            max-width: 1200px;
            margin-left: auto;
            margin-right: auto;
        }
        .sidebar-header {
            padding: 20px;
            color: #fff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.12);
            margin-bottom: 20px;
        }
        .sidebar-header h4 {
            margin: 0;
            font-size: 1.2rem;
        }
        .sidebar-header small {
            color: rgba(255, 255, 255, 0.7);
            font-size: 0.85rem;
        }
        .top-navbar {
            background: linear-gradient(90deg, #1E3A5F 0%, #2E5C8A 100%);
            color: #fff;
            border-bottom: none;
            padding: 12px 20px;
            margin-left: 250px;
            position: sticky;
            top: 0;
            z-index: 999;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }
        .top-navbar h5 {
            color: #fff;
            margin: 0;
        }
        .top-navbar .text-muted {
            color: rgba(255, 255, 255, 0.9) !important;
        }
        .top-navbar strong {
            color: #fff;
        }
        .nav-divider {
            color: rgba(255, 255, 255, 0.5);
            font-size: 0.75rem;
            text-transform: uppercase;
            padding: 10px 20px;
            margin-top: 10px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-header">
            <h4>EnglishLearning</h4>
            <small>Quản trị hệ thống</small>
        </div>
        <nav class="nav flex-column">
            <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
               asp-controller="Admin" asp-action="Index">
                <i class="bi bi-house-door"></i> Dashboard
            </a>
            
            <div class="nav-divider">Kỹ năng</div>
            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Listening" ? "active" : "")" 
               href="/Admin/Listening">
                <i class="bi bi-earbuds"></i> Listening
            </a>
            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Speaking" ? "active" : "")" 
               href="/Admin/Speaking">
                <i class="bi bi-mic"></i> Speaking
            </a>
            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Reading" ? "active" : "")" 
               href="/Admin/Reading">
                <i class="bi bi-book"></i> Reading
            </a>
            
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Writing" ? "active" : "")" 
               href="/Admin/Writing">
                <i class="bi bi-pencil"></i> Writing
            </a>
            
            <div class="nav-divider">Khóa học</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Courses" ? "active" : "")" 
               href="/Admin/Courses">
                <i class="bi bi-journal-bookmark"></i> Quản lý khóa học
            </a>
            
            <div class="nav-divider">Nội dung</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "News" ? "active" : "")" 
               href="/Admin/News">
                <i class="bi bi-newspaper"></i> Tin tức
            </a>

            <div class="nav-divider">Người dùng</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Users" ? "active" : "")"
               href="/Admin/Users">
                <i class="bi bi-people"></i> Quản lý người dùng
            </a>

            <div class="nav-divider">Thống kê</div>
            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Stats" ? "active" : "")"
               href="/Admin/Stats">
                <i class="bi bi-bar-chart-line"></i> Thống kê học tập
            </a>
            
            <form asp-controller="Auth" asp-action="Logout" method="post" class="px-3 mt-3">
                <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                    <i class="bi bi-box-arrow-right"></i> Đăng xuất
                </button>
            </form>
        </nav>
    </div>

    <div class="top-navbar">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="mb-0">@ViewData["Title"]</h5>
            </div>
            <div>
                <span class="text-muted">Xin chào, <strong>@User.Identity?.Name</strong></span>
            </div>
        </div>
    </div>

    <div class="main-content">
        <div class="admin-content-wrap">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

